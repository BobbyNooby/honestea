{
  "expo": {
    "name": "HonesTea",
    "slug": "honestea",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "honestea",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.honestai.honestea",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "HonesTea uses on-device speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "HonesTea needs microphone access to transcribe your voice into the chat."
      }
    },
    "android": {
      "package": "app.honestai.honestea",
      "adaptiveIcon": {
        "backgroundColor": "#fbf6e9",
        "foregroundImage": "./assets/app-icon-foreground.png",
        "monochromeImage": "./assets/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fbf6e9",
          "dark": {
            "backgroundColor": "#1c1917"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HonesTea needs access to your photos to attach images to a chat.",
          "cameraPermission": "HonesTea needs camera access to take photos and ask the AI about them."
        }
      ],
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "HonesTea needs microphone access to transcribe your voice into the chat.",
          "speechRecognitionPermission": "HonesTea uses on-device speech recognition to convert your voice to text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ea15872-175b-4dae-adf8-7bdbada55501"
      }
    }
  }
}
