# Server-only secrets. Never commit .env.
# Set these in Railway/Fly dashboard for production.
#
# Copy this file to .env (same directory) and fill in real values.

# REQUIRED for /api/chat to work.
# Get from https://openrouter.ai/keys after creating an account + adding credits.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Everything below is for later phases (auth, billing, direct providers).
# Leave commented out until you're actually wiring those features in.
# ---------------------------------------------------------------------------

# Direct provider keys (Phase 3+, when migrating high-volume models off OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=...

# Database (Phase 2)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Better Auth (Phase 2)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001

# OAuth providers (Phase 2)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Stripe (Phase 2)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
