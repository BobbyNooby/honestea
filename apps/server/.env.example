# Server-only secrets. Never commit .env.
# Set these in Railway/Fly dashboard for production.
#
# Copy this file to .env (same directory) and fill in real values.

# REQUIRED for /api/chat to work.
# Get from https://openrouter.ai/keys after creating an account + adding credits.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Better Auth (required for auth)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# OAuth providers — fill in the ones you want to enable.
# Callback URLs (all route to the server):
#   GitHub:    http://localhost:3001/api/auth/callback/github
#   Google:    http://localhost:3001/api/auth/callback/google
#   Facebook:  http://localhost:3001/api/auth/callback/facebook
#   Twitter:   http://localhost:3001/api/auth/callback/twitter
#   Instagram: http://localhost:3001/api/auth/callback/instagram
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Everything below is for later phases (billing, direct providers).
# Leave commented out until you're actually wiring those features in.
# ---------------------------------------------------------------------------

# Direct provider keys (Phase 3+, when migrating high-volume models off OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=...

# Database (Phase 2)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Stripe (Phase 2)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
