# Server-only secrets. Never commit .env.
# Set these in Railway/Fly dashboard for production.

# AI providers (master keys for hosted tier)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=...

# Database
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# OAuth providers (server-side secrets only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Misc
PORT=3001
NODE_ENV=development
