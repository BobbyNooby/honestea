{
  "name": "honestea",
  "version": "0.0.0",
  "private": true,
  "description": "HonesTea — local-first BYOK AI chat harness",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "mprocs",
    "dev:app": "pnpm --filter @honestea/app dev",
    "dev:client": "pnpm --filter @honestea/app dev:client",
    "run:android": "pnpm --filter @honestea/app run:android",
    "run:ios": "pnpm --filter @honestea/app run:ios",
    "prebuild": "pnpm --filter @honestea/app prebuild",
    "prebuild:clean": "pnpm --filter @honestea/app prebuild:clean",
    "eas:configure": "cd apps/app && eas build:configure",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:build:android": "cd apps/app && eas build --platform android --profile preview",
    "eas:build:android:prod": "cd apps/app && eas build --platform android --profile production",
    "eas:build:ios": "cd apps/app && eas build --platform ios --profile preview",
    "eas:build:ios:prod": "cd apps/app && eas build --platform ios --profile production",
    "eas:build:list": "cd apps/app && eas build:list",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test": "vitest run"
  },
  "devDependencies": {
    "mprocs": "^0.7.2",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@sinclair/typebox": "^0.34.0"
    }
  }
}
