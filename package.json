{
  "name": "honestea",
  "version": "0.0.0",
  "private": true,
  "description": "Honest AI — transparent multi-model AI chat platform",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "mprocs",
    "dev:app": "pnpm --filter @honestea/app dev",
    "dev:server": "pnpm --filter @honestea/server dev",
    "dev:web": "pnpm --filter @honestea/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "mprocs": "^0.7.2",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@sinclair/typebox": "^0.34.0"
    }
  }
}
